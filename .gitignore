# Secrets — never commit
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual envs
venv/
.venv/
.venv*/
env/

# Traces (may contain PII/tokens; regenerated by check scripts)
traces/**/*.jsonl
repair/traces/*.jsonl
repair/snapshots/
checks/results_summary.json
checks/acceptance_summary.json
checks/diagnostics_summary.json

# Tracked sanitized evidence bundle is intentionally NOT ignored:
# evidence/traces/** and evidence/manifest.json are committed.

# Local corpus artefacts (large and reproducible via ingest.build)
corpus/*.pdf
corpus/pages.jsonl
corpus/chunks.jsonl

# chromadb telemetry writes a session file named literally ":memory:.ses"
:memory:*

# Chroma persistent DB (rebuilt by ingest/index.py)
chroma_db/

# Approved guide artifacts (generated locally; ledger is the source of truth)
artifacts/

# tiktoken BPE cache (downloaded on first use; ~2 MB, reproducible)
.tiktoken_cache/

# IDE
.idea/
.vscode/
*.swp
.DS_Store
